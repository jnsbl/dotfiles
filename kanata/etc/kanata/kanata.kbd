;; vim: set ft=lisp:

(defcfg
  process-unmapped-keys yes
)

(defsrc
;; ;     +      ě      š      č      ř      ž      ý      á      í      é      =      ´
  grv    1      2      3      4      5      6      7      8      9      0      -      =      bspc
  tab    q      w      e      r      t      y      u      i      o      p      [      ]
  caps   a      s      d      f      g      h      j      k      l      ;      '      \      ret
  lsft   102d   z      x      c      v      b      n      m      ,      .      /      rsft
  lctl   lmet   lalt                 spc                         ralt   rmet   rctl
)

(defvar
  ;; Tap-hold timing strategy:
  ;; - tap-timeout: time allowed for tap action (should be longer than hold-timeout)
  ;; - hold-timeout: time after which hold action activates (shorter = feels more responsive)
  ;; - tap-timeout-zero: for special cases where tap must complete quickly

  tap-timeout-zero 0         ;; tap completes immediately, hold only via explicit hold duration
  hold-timeout-fast 140      ;; fast activation for responsive feel
  tap-timeout 250            ;; generous tap window (should be > hold-timeout)
  hold-timeout 170           ;; standard hold threshold

  time-out-fast 170
  time-out 200
  time-out-long 2000
)

(defalias
  ;; CapsLock acts as Escape on tap, Control on hold
  escctl (tap-hold-press $tap-timeout $hold-timeout esc lctl)

  ;; Navigation and shortcut layer - space-fn
  spacefn (tap-hold-release $tap-timeout-zero $hold-timeout spc (layer-while-held navigation))
)

(deflayer base
  grv    1      2      3      4      5      6      7      8      9      0      -      =      bspc
  tab    q      w      e      r      t      y      u      i      o      p      [      ]
  @escctl  a    s      d      f      g      h      j      k      l      ;      '      \      ret
  lsft   102d   z      x      c      v      b      n      m      ,      .      /      rsft
  lctl   lmet   lalt                 @spacefn                    ralt   rmet   rctl
)

(deflayer navigation
  XX     f1     f2     f3     f4     f5     f6     f7     f8     f9     f10    f11    f12    XX
  XX     XX     XX     XX     XX     XX     XX     home   pgdn   pgup   end    XX     XX
  XX     XX     XX     XX     XX     XX     XX     left   down   up     right  XX     XX     XX
  _      XX     XX     XX     XX     XX     XX     XX     XX     XX     XX     XX     _
  _      _      _                    spc                         _      _      _
)
