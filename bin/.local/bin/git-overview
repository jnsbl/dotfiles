#!/usr/bin/env bash
# git-overview.sh — prints Git info for each first-level subdirectory of CWD

set -u

BOLD='\033[1m'
GREEN='\033[0;32m'
DIM='\033[2m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

field() {
    printf "  ${YELLOW}%-10s${RESET} %s\n" "$1" "$2"
}

shopt -s nullglob

found=0
for entry in */; do
    [[ -d "$entry" ]] || continue
    found=1
    dir="${entry%/}"

    printf "\n${BOLD}${CYAN}--- %s ---${RESET}\n" "$dir"

    if ! git -C "$dir" rev-parse --git-dir > /dev/null 2>&1; then
        printf "  ${DIM}not a git repository${RESET}\n"
        continue
    fi

    printf "  ${GREEN}git repository${RESET}\n"

    # Current branch — handles detached HEAD
    branch=$(git -C "$dir" branch --show-current 2>/dev/null || true)
    if [[ -z "$branch" ]]; then
        hash=$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || echo "unknown")
        field "branch:" "detached HEAD @ $hash"
    else
        field "branch:" "$branch"
    fi

    # Current worktree root (absolute path)
    worktree=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || echo "unknown")
    field "worktree:" "$worktree"

    # Remote(s) — fetch URLs only, one line per remote
    remote_count=0
    while IFS=$'\t' read -r name url; do
        field "remote:" "$name  $url"
        remote_count=$((remote_count + 1))
    done < <(git -C "$dir" remote -v 2>/dev/null | awk '/\(fetch\)/ { print $1 "\t" $2 }')

    [[ $remote_count -eq 0 ]] && field "remote:" "(none)"
done

if [[ $found -eq 0 ]]; then
    printf "No subdirectories found in %s\n" "$(pwd)"
fi
